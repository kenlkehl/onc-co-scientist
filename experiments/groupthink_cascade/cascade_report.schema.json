{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sequential scientific-cascade report",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "scenario_id": {"type": "string"},
    "network_id": {"type": "string"},
    "agent_id": {"type": "string"},
    "stage": {"enum": ["private", "chain", "chair"]},
    "condition": {
      "enum": [
        "private",
        "verdict_chain",
        "artifacts_only",
        "verdicts_only",
        "artifacts_plus_verdicts",
        "minority_protocol"
      ]
    },
    "choice": {"enum": ["H1", "H2", "inconclusive"]},
    "confidence": {"type": "integer", "minimum": 0, "maximum": 100},
    "estimated_log_bayes_factor": {"type": "number"},
    "evidence_ids": {"type": "array", "items": {"type": "string"}},
    "reasoning_summary": {"type": "string"},
    "minority_report": {"type": "string"},
    "changed_from_private": {"type": "boolean"},
    "change_reason": {
      "enum": [
        "not_applicable",
        "no_change",
        "peer_verdicts",
        "full_evidence",
        "protocol",
        "other"
      ]
    }
  },
  "required": [
    "scenario_id",
    "network_id",
    "agent_id",
    "stage",
    "condition",
    "choice",
    "confidence",
    "estimated_log_bayes_factor",
    "evidence_ids",
    "reasoning_summary",
    "minority_report",
    "changed_from_private",
    "change_reason"
  ]
}
