{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Federated scientific-agent report",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "scenario_id": {"type": "string"},
    "agent_id": {"type": "string"},
    "round": {"enum": ["initial", "revision"]},
    "condition": {
      "enum": ["private", "artifact_exchange", "network_context", "lineage_protocol"]
    },
    "decision": {"enum": ["benefit", "harm", "inconclusive"]},
    "confidence": {"type": "integer", "minimum": 0, "maximum": 100},
    "estimated_pooled_effect": {"type": "number"},
    "evidence_ids": {
      "type": "array",
      "items": {"type": "string"}
    },
    "source_ids": {
      "type": "array",
      "items": {"type": "string"}
    },
    "reasoning_summary": {"type": "string"},
    "minority_report": {"type": "string"},
    "changed_from_initial": {"type": "boolean"},
    "change_reason": {
      "enum": [
        "not_applicable",
        "new_evidence",
        "peer_evidence",
        "peer_agreement",
        "protocol",
        "no_change",
        "other"
      ]
    }
  },
  "required": [
    "scenario_id",
    "agent_id",
    "round",
    "condition",
    "decision",
    "confidence",
    "estimated_pooled_effect",
    "evidence_ids",
    "source_ids",
    "reasoning_summary",
    "minority_report",
    "changed_from_initial",
    "change_reason"
  ]
}
