{
  "explore": {
    "$defs": {
      "Condition": {
        "additionalProperties": false,
        "properties": {
          "variable": {
            "title": "Variable",
            "type": "string"
          },
          "op": {
            "default": "eq",
            "enum": [
              "eq",
              "ge",
              "le"
            ],
            "title": "Op",
            "type": "string"
          },
          "value": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              }
            ],
            "title": "Value"
          }
        },
        "required": [
          "variable",
          "value"
        ],
        "title": "Condition",
        "type": "object"
      },
      "Judgment": {
        "additionalProperties": false,
        "properties": {
          "claim": {
            "title": "Claim",
            "type": "string"
          },
          "status": {
            "enum": [
              "accept",
              "reject",
              "unresolved"
            ],
            "title": "Status",
            "type": "string"
          },
          "investigation": {
            "enum": [
              "active",
              "deferred",
              "closed"
            ],
            "title": "Investigation",
            "type": "string"
          },
          "evidence": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Evidence"
          }
        },
        "required": [
          "claim",
          "status",
          "investigation"
        ],
        "title": "Judgment",
        "type": "object"
      },
      "Proposal": {
        "additionalProperties": false,
        "properties": {
          "outcome": {
            "title": "Outcome",
            "type": "string"
          },
          "exposure": {
            "title": "Exposure",
            "type": "string"
          },
          "exposed": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              }
            ],
            "default": 1.0,
            "title": "Exposed"
          },
          "comparator": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              }
            ],
            "default": 0.0,
            "title": "Comparator"
          },
          "contrast": {
            "default": "mean_difference",
            "enum": [
              "mean_difference",
              "interaction"
            ],
            "title": "Contrast",
            "type": "string"
          },
          "eligibility": {
            "items": {
              "$ref": "#/$defs/Condition"
            },
            "title": "Eligibility",
            "type": "array"
          },
          "subgroup": {
            "items": {
              "$ref": "#/$defs/Condition"
            },
            "title": "Subgroup",
            "type": "array"
          },
          "direction": {
            "enum": [
              -1,
              1
            ],
            "title": "Direction",
            "type": "integer"
          },
          "anticipated_direction": {
            "enum": [
              -1,
              0,
              1
            ],
            "title": "Anticipated Direction",
            "type": "integer"
          },
          "initial_status": {
            "enum": [
              "accept",
              "reject",
              "unresolved"
            ],
            "title": "Initial Status",
            "type": "string"
          },
          "parent": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Parent"
          },
          "motivating_evidence": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Motivating Evidence"
          }
        },
        "required": [
          "outcome",
          "exposure",
          "direction",
          "anticipated_direction",
          "initial_status"
        ],
        "title": "Proposal",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "proposals": {
        "items": {
          "$ref": "#/$defs/Proposal"
        },
        "title": "Proposals",
        "type": "array"
      },
      "assessments": {
        "items": {
          "$ref": "#/$defs/Judgment"
        },
        "title": "Assessments",
        "type": "array"
      },
